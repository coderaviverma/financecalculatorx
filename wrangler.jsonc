{
  // Finance Calculator X — static site served by Cloudflare Workers assets,
  // fronted by a tiny worker that canonicalizes host/scheme and adds HSTS.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "financecalculatorx",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
